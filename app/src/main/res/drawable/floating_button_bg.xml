<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Внешнее красное свечение -->
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="50%"
                android:startColor="#66E53935" android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Основной круг с градиентом -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <gradient android:type="linear" android:angle="315"
                android:startColor="#FFFF5252" android:centerColor="#FFE53935" android:endColor="#FFB71C1C" />
            <stroke android:width="2dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
